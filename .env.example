# Discord bot token. Keep this only on the relay daemon host.
DISCORD_BOT_TOKEN=replace-with-discord-bot-token

# Shared authentication token used by wrapper clients.
# Generate one with: openssl rand -hex 32
WRAPPING_BOT_SHARED_TOKEN=replace-with-long-random-token

# Optional comma-separated allowlist for client-selected Discord channel IDs.
# Leave empty to allow any channel that the Discord bot can access.
WRAPPING_BOT_ALLOWED_CHANNEL_IDS=123456789012345678,234567890123456789

WRAPPING_BOT_LISTEN_ADDR=:8080
WRAPPING_BOT_FLUSH_INTERVAL=1500ms
WRAPPING_BOT_MAX_LOG_CHUNK_BYTES=1600
WRAPPING_BOT_QUEUE_SIZE=1024
WRAPPING_BOT_MAX_CONCURRENT_RUNS=32
WRAPPING_BOT_MAX_STREAM_BYTES=1073741824
WRAPPING_BOT_STRIP_ANSI=true

# Host port published by Docker Compose.
WRAPPING_BOT_HOST_PORT=8080
