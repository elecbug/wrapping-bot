# Address reachable from the experiment machine.
WRAPPING_BOT_ENDPOINT=http://relay-host.example:8080

# Must match WRAPPING_BOT_SHARED_TOKEN on the daemon.
WRAPPING_BOT_TOKEN=replace-with-long-random-token

# Alias defined in daemon WRAPPING_BOT_CHANNELS.
WRAPPING_BOT_TARGET=default

# Optional display label in Discord.
WRAPPING_BOT_RUN_NAME=PeerKit experiment

# Only selected environment variables are relayed.
WRAPPING_BOT_ENV_KEYS=RUN_ID,TOPOLOGY,PROTOCOL,NODES,SEED
WRAPPING_BOT_ENV_PREFIXES=EXP_,PEERKIT_

WRAPPING_BOT_CLIENT_QUEUE_SIZE=1024
WRAPPING_BOT_FINISH_TIMEOUT=15s
